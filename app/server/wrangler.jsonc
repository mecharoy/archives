{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-khata",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-khata",
      "database_id": "PUT-YOUR-DATABASE-ID-HERE"
    }
  ]
}

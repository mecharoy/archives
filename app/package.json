{
  "name": "site-khata",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "schema": "node scripts/gen-schema.mjs",
    "apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "test": "node scripts/smoke.mjs",
    "test:sync": "node scripts/smoke-sync.mjs",
    "server:dev": "cd server && npx wrangler dev --local --port 8799",
    "server:test": "cd server && ./test.sh",
    "server:deploy": "cd server && npx wrangler deploy"
  },
  "dependencies": {
    "@capacitor-community/contacts": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.3",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  }
}
